# ---------------------------------------------------------------------------
# VibeSound AI environment
# Copy this file to `.env.local` and fill in only what you need.
# ---------------------------------------------------------------------------

# No music API key is required. The app uses Apple's public iTunes Search API
# and Apple Music chart feeds, with 30-second previews for playback.
# Optional default storefront for general searches (US, NG, ZA, KE, GH, TZ...).
MUSIC_COUNTRY=US

# Optional: absolute site URL used for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Companion / AI Playlist Journey (server-only — never prefix with NEXT_PUBLIC)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. Without these, the app
# runs its transparent rule-based intent interpreter and says so in the UI.

# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Local Ollama example (no key needed when the base URL is localhost):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
